{
  "name": "dsh-archive-manager",
  "version": "0.1.0",
  "license": "MIT",
  "description": "会话归档管理：侧栏独立入口面板，列出已归档会话，可放回对话或永久删除。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "web"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "verifiedWith": "0.1.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node parts/smoke.mjs"
  }
}