  "dsh": {
    "verifiedWith": "0.1.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node parts/build.mjs",
    "test": "node parts/smoke.mjs"
